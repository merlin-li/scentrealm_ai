# Vercel environment variables; no secrets in client code or Git.
NUTRISNAP_WECHAT_APPID=wx7dd5a13a9e867182
NUTRISNAP_WECHAT_SECRET=
NUTRISNAP_VISION_API_KEY=
NUTRISNAP_VISION_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
NUTRISNAP_VISION_MODEL=qwen3.8-flash
NUTRISNAP_DAILY_RECOGNITION_LIMIT=50

# Reuse the existing project's MySQL configuration.
MYSQL_HOST=rdsuf5mqwljzynpys5pwpeo.mysql.rds.aliyuncs.com
MYSQL_PORT=3306
MYSQL_USER=smart_device
MYSQL_PASSWORD=
MYSQL_DATABASE=smart_device
MYSQL_CONNECTION_LIMIT=3
# NUTRISNAP_SESSION_SECRET is no longer required: sessions are random tokens stored as hashes in MySQL.

# AI 熔断开关；false 时保留登录、手动记录功能。
NUTRISNAP_AI_ENABLED=true
# 内测准入：服务端用户 UUID，以逗号分隔；留空允许所有微信认证用户。
NUTRISNAP_AI_ALLOWED_USER_IDS=
# 全实例共享的请求次数上限，不是精确金额或 token 预算。
NUTRISNAP_AI_GLOBAL_PER_MINUTE=30
NUTRISNAP_AI_GLOBAL_PER_DAY=500
NUTRISNAP_LOGIN_PER_MINUTE=120
